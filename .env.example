# GitHub REST API — required for `scrape`. Even public-repo reads need auth
# to get a workable rate limit. Create a token with no special scopes at
# https://github.com/settings/tokens
GITHUB_TOKEN=

# OpenRouter — single key routes to Claude, GPT, and Gemini (see config.yaml
# `models`). https://openrouter.ai/keys
OPENROUTER_API_KEY=
